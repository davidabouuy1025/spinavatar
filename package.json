{
  "name": "spinavatar",
  "displayName": "spinavatar",
  "publisher": "davidabouuy",
  "description": "Let your friend SPIN beside you while you are coding.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SpinAvatar",
      "properties": {
        "spinavatar.imagePath": {
          "type": "string",
          "default": "",
          "description": "Path to avatar image"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "avatarView",
          "name": "Spin Avatar",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "spinavatar.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.21",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidabouuy1025/spinavatar.git"
  }
}